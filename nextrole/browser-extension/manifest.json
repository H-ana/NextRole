{
  "manifest_version": 3,
  "name": "NextRole Application Autofill",
  "version": "1.4.0",
  "description": "Save your reviewed NextRole profile and resume directly, then preview and fill application fields. You review and submit.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NextRole autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://nextrole-job-match.blueowl129.chatgpt.site/",
  "content_scripts": [
    {
      "matches": [
        "https://nextrole-job-match.blueowl129.chatgpt.site/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "extension-config.js",
        "site-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
